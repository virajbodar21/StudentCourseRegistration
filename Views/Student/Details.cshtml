@model StudentCourseRegistration.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Student Profile Details</h4>
                <span class="badge bg-light text-primary fs-6">ID #@Model.Id</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Full Name</label>
                        <div class="fs-5 fw-semibold text-dark">@Model.Name</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Email Address</label>
                        <div class="fs-5 text-dark">
                            <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Course / Department</label>
                        <div class="fs-5 text-dark">@Model.Course</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Current Semester</label>
                        <div class="fs-5">
                            <span class="badge bg-success px-3 py-2">Semester @Model.Semester</span>
                        </div>
                    </div>
                </div>

                <div class="alert alert-light border d-flex align-items-center gap-3 py-2 px-3 mb-4">
                    <div class="text-primary fs-4">&check;</div>
                    <div class="small text-secondary">
                        Registration status is <strong>Active and Verified</strong> under the Department of Computer Engineering.
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        &larr; Back to Student Directory
                    </a>
                    <a asp-action="Create" class="btn btn-outline-primary">
                        + Register Another Student
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
