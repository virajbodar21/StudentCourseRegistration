@model StudentCourseRegistration.Models.Student

@{
    ViewData["Title"] = "Student Registration";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-person-plus-fill"></i> Student Course Registration Form</h4>
                <small class="text-white-50">Please fill out the form below. All fields are validated with Data Annotations.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Akshar Parekh" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="e.g. aksharparekh180@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Course" class="form-label fw-semibold"></label>
                        <input asp-for="Course" class="form-control" placeholder="e.g. B.Tech Computer Engineering" />
                        <span asp-validation-for="Course" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Semester" class="form-label fw-semibold"></label>
                        <input asp-for="Semester" type="number" class="form-control" placeholder="e.g. 5 (Allowed: 1 to 8)" min="1" max="8" />
                        <span asp-validation-for="Semester" class="text-danger small"></span>
                        <div class="form-text">Enter an integer between 1 and 8 representing the student's current semester.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Back to Student List
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            Submit Registration
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
