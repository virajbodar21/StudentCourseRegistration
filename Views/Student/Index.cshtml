@model IEnumerable<StudentCourseRegistration.Models.Student>

@{
    ViewData["Title"] = "Student List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-primary mb-1"><i class="bi bi-people-fill"></i> Registered Students Directory</h2>
        <p class="text-muted mb-0">Browse through the list of enrolled students or register a new candidate.</p>
    </div>
    <a asp-action="Create" class="btn btn-success px-4 py-2 shadow-sm">
        + Register New Student
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white py-3">
        <h5 class="card-title mb-0">Enrolled Students (@Model.Count())</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Student ID</th>
                        <th>Student Name</th>
                        <th>Email Address</th>
                        <th>Course / Program</th>
                        <th>Semester</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var student in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@student.Id</td>
                                <td class="fw-semibold text-dark">@student.Name</td>
                                <td>
                                    <a href="mailto:@student.Email" class="text-decoration-none">@student.Email</a>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark px-2 py-1">@student.Course</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary px-2 py-1">Semester @student.Semester</span>
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No student records found. Click 'Register New Student' to add one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
